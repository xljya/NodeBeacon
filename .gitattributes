* text=auto

# Keep Unix/Linux scripts and project text stable across operating systems.
*.sh text eol=lf
*.bash text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.lock text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.md text eol=lf
*.html text eol=lf
*.svg text eol=lf
Dockerfile text eol=lf

# Preserve the vendored NodeBeacon-Web commit byte-for-byte. Its upstream
# sources contain historical trailing whitespace; formatting is owned there.
apps/status-web/** -whitespace

# Keep native Windows scripts in CRLF when they are added later.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never normalize binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
