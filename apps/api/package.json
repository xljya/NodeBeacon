    "@fastify/websocket": "^11.3.0",
    "@node-rs/argon2": "^2.0.2",
    "@nodebeacon/shared": "workspace:*",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.3.3",
    "prom-client": "^15.1.3",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "tsx": "^4.20.3",
    "vitest": "^2.1.9"
