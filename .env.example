NODE_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=3001
WEB_ORIGIN=http://localhost:5173

# Prometheus stays server-side. Do not expose credentials to the browser.
PROMETHEUS_URL=http://10.77.0.1:31001
PROMETHEUS_TIMEOUT_MS=5000
PROMETHEUS_BASIC_AUTH_USERNAME=
PROMETHEUS_BASIC_AUTH_PASSWORD=
PROMETHEUS_BEARER_TOKEN=
STATUS_CACHE_TTL_SECONDS=30

# Alertmanager stays server-side. The webhook token authenticates cluster-internal
# POST /api/webhooks/alertmanager requests and must be stored as a secret.
ALERTMANAGER_URL=http://localhost:9093
ALERTMANAGER_TIMEOUT_MS=5000
ALERTMANAGER_WEBHOOK_TOKEN=replace-with-a-random-32-byte-secret

# Node metadata. Copy config/nodes.example.yaml and point this to the real file.
NODEBEACON_NODE_CONFIG=../../config/nodes.example.yaml
# Optional read-only seed used when NODEBEACON_NODE_CONFIG points to a writable
# runtime file that does not exist yet (production uses ConfigMap seed + PVC).
NODEBEACON_NODE_CONFIG_SEED=

# SQLite state (revocable sessions + persisted audit events). The node registry
# remains YAML. Production defaults to /data/nodebeacon.db.
NODEBEACON_DATABASE_PATH=./data/nodebeacon.db

# Auth. The owner (admin) is provisioned from these values; registration stays off.
ALLOW_REGISTER=false
COOKIE_SECRET=replace-with-a-random-32-byte-secret
INITIAL_OWNER_EMAIL=owner@example.com
INITIAL_OWNER_PASSWORD=replace-me-before-production
SESSION_TTL_SECONDS=604800
INCIDENT_RETENTION_DAYS=180
AUDIT_RETENTION_DAYS=365
REVOKED_SESSION_RETENTION_DAYS=30

# GitHub OAuth login (optional). Only the account whose login === GITHUB_OWNER_LOGIN
# is accepted as owner; any other GitHub user is rejected. Create a GitHub OAuth App
# and set the callback to https://<your-domain>/api/auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OWNER_LOGIN=xljya
# Optional overrides for building the OAuth callback URL (derived from the request
# by default; set these if you run behind a proxy that rewrites host/proto):
# GITHUB_CALLBACK_URL=https://monitor.liucf.com/api/auth/github/callback
# PUBLIC_BASE_URL=https://monitor.liucf.com

# Blackbox probe job label surfaced on the public /api/latency endpoint.
# Leave empty to disable the probe panel.
PROBE_JOB=blackbox-http-public
