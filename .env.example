NODE_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=3001
WEB_ORIGIN=http://localhost:5173

# Prometheus stays server-side. Do not expose credentials to the browser.
PROMETHEUS_URL=http://10.77.0.1:31001
PROMETHEUS_TIMEOUT_MS=5000
PROMETHEUS_BASIC_AUTH_USERNAME=
PROMETHEUS_BASIC_AUTH_PASSWORD=
PROMETHEUS_BEARER_TOKEN=
STATUS_CACHE_TTL_SECONDS=30

# Node metadata. Copy config/nodes.example.yaml and point this to the real file.
NODEBEACON_NODE_CONFIG=../../config/nodes.example.yaml

# Auth is not implemented in P0; values are reserved for the P3 login/admin work.
ALLOW_REGISTER=false
COOKIE_SECRET=replace-with-a-random-32-byte-secret
INITIAL_OWNER_EMAIL=owner@example.com
INITIAL_OWNER_PASSWORD=replace-me-before-production
