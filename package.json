{
  "name": "nodebeacon",
  "version": "1.0.40",
  "private": true,
  "description": "Self-hosted node monitoring and uptime dashboard powered by Prometheus.",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm --filter @nodebeacon/shared build && pnpm --parallel --filter @nodebeacon/api --filter @nodebeacon/web dev",
    "dev:api": "pnpm --filter @nodebeacon/shared build && pnpm --filter @nodebeacon/api dev",
    "dev:web": "pnpm --filter @nodebeacon/shared build && pnpm --filter @nodebeacon/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @nodebeacon/shared build && pnpm -r test",
    "test:e2e": "playwright test --project=edge",
    "test:e2e:ui": "playwright test --project=edge --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^20.19.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.0.0"
  }
}
